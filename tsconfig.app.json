{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".work/typecheck/app",
    "tsBuildInfoFile": ".work/typecheck/app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/editor/worker.ts"]
}
